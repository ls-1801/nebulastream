#!/usr/bin/env bash
# Run commands inside the NebulaStream development container.
#
# Usage:
#   devc cmake -B nebulastream/build nebulastream
#   devc cmake --build nebulastream/build -j8
#   devc ctest --test-dir nebulastream/build -R QueryEngineTest --output-on-failure
#   devc bash   # interactive shell

set -euo pipefail

WORKSPACE="$(cd "$(dirname "$0")/.." && pwd)"

exec docker run --rm \
    -v "${WORKSPACE}:/workspace" \
    -v ccache:/ccache \
    -e CCACHE_DIR=/ccache \
    -e CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 \
    -v $HOME/.claude:$HOME/.claude \
    -w /workspace \
    -it \
    nebulastream/nes-development:claude \
    $HOME/.local/bin/claude --allow-dangerously-skip-permissions "$@" 